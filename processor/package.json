{
  "name": "tianzong-clip-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Private TianClip Engine API and media-processing worker",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "test": "npm run build && node --test $(find dist -type f \\( -name '*.test.js' -o -name '*.test.mjs' \\) -print)",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@aws-sdk/s3-request-presigner": "3.888.0",
    "adm-zip": "0.5.16",
    "ajv": "8.17.1",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}
