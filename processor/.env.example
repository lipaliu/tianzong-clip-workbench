# The process refuses to start if any required production value is missing.
NODE_ENV=production
PORT=10000
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@host:5432/tianclip?sslmode=require
DATABASE_SSL=true

# JSON object. Every secret must contain at least 32 characters.
INTERNAL_API_KEYS={"sites-proxy":"replace-with-a-long-random-secret"}
INTERNAL_SIGNATURE_TTL_SECONDS=300

# S3-compatible private object storage. Production uses Tencent COS; the
# historical R2_* variable names remain internal API names to avoid a risky
# storage migration. COS example:
# https://cos.<region>.myqcloud.com
R2_ENDPOINT=https://cos.ap-singapore.myqcloud.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=tianclip-private-APPID
R2_REGION=ap-singapore
# URLs are issued just-in-time in small batches; one hour also tolerates slow
# internal-team uplinks without exposing a permanent upload address.
PRESIGN_TTL_SECONDS=3600
PREVIEW_TTL_SECONDS=600
# Browser uploads automatically use one PUT below 4.9 GB and R2 multipart
# above it. The 9 GB internal cap includes the known 8,242,271,965-byte
# July 3 regression recording while leaving scratch space for derived media.
MAX_UPLOAD_BYTES=9000000000
SINGLE_PUT_MAX_BYTES=4900000000
MULTIPART_PART_SIZE_BYTES=67108864
MULTIPART_PRESIGN_BATCH_SIZE=12

# Explicit models are required so a release never silently changes model behavior.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol

# Production model routing. Doubao creates Chinese transcript/timecodes and
# performs native audio-video evidence review; GPT-5.6 Sol remains the final
# private-Skill-bound editor. Failures are recorded before the safe fallback is
# used, and no fallback may claim that native AV review happened.
TRANSCRIPTION_PROVIDER=doubao
TRANSCRIPTION_FALLBACK_TO_OPENAI=true
CANDIDATE_AV_REVIEW_PROVIDER=doubao
AV_REVIEW_FALLBACK_TO_SAMPLED_STILLS=true
PROVIDER_URL_TTL_SECONDS=3600

# Doubao BigASR standard recording-file recognition (up to five hours under
# the provider contract). These values stay server-side.
DOUBAO_ASR_APP_KEY=replace-me
DOUBAO_ASR_ACCESS_KEY=replace-me
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc
DOUBAO_ASR_BASE_URL=https://openspeech.bytedance.com
DOUBAO_ASR_REQUEST_TIMEOUT_MS=60000
DOUBAO_ASR_POLL_INTERVAL_MS=5000
DOUBAO_ASR_POLL_TIMEOUT_MS=1800000

# Volcengine Ark native audio-video candidate review. Responses mode is pinned
# so every result is checked against the strict JSON Schema.
DOUBAO_ARK_API_KEY=replace-me
DOUBAO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_AV_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_AV_API_MODE=responses
DOUBAO_AV_VIDEO_FPS=2
DOUBAO_AV_MAX_OUTPUT_TOKENS=8000
DOUBAO_AV_MAX_BOUNDARY_EXTENSION_SEC=8
DOUBAO_AV_TIMEOUT_MS=900000

# Upload the private .skill bundle to the private COS bucket. Pin its checksum.
TIANCLIP_CORE_S3_KEY=private-core/tianzong-video-clipping-1.2.2-private.1.skill
TIANCLIP_CORE_SHA256=7a0a611091f60d1136eb965944bd3bfa96b2290a8d8d730c22821f7b41bf9f1d
TIANCLIP_CORE_VERSION=1.2.2-private.1
TIANCLIP_PROMPT_VERSION=1.2.2
TIANCLIP_SCHEMA_VERSION=1.1.0
TIANCLIP_FACT_SCHEMA_VERSION=1.0.0
TIANCLIP_LEDGER_SCHEMA_VERSION=1.0.0

JOB_POLL_INTERVAL_MS=1500
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
# Worker independently reports liveness every 30 seconds. The API readiness
# gate and new-job admission fail closed after 120 seconds without a heartbeat.
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
TRANSCRIPTION_SEGMENT_SECONDS=600
VISION_SAMPLE_SECONDS=12
VISION_BATCH_SIZE=8
CANDIDATE_FRAME_SECONDS=2
ANALYSIS_WINDOW_SECONDS=600
# Tencent CVM mounts the worker scratch volume here. This directory is
# disposable; private COS is the durable source of truth.
WORK_DIRECTORY=/var/data/tianclip
