# The process refuses to start if any required production value is missing.
NODE_ENV=production
PORT=10000
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@host:5432/tianclip?sslmode=require

# JSON object. Every secret must contain at least 32 characters.
INTERNAL_API_KEYS={"sites-proxy":"replace-with-a-long-random-secret"}
INTERNAL_SIGNATURE_TTL_SECONDS=300

# Cloudflare R2 (private bucket; no public development URL).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=tianclip-private
R2_REGION=auto
# URLs are issued just-in-time in small batches; one hour also tolerates slow
# internal-team uplinks without exposing a permanent upload address.
PRESIGN_TTL_SECONDS=3600
PREVIEW_TTL_SECONDS=600
# Browser uploads automatically use one PUT below 4.9 GB and R2 multipart
# above it. The 9 GB internal cap includes the known 8,242,271,965-byte
# July 3 regression recording while leaving scratch space for derived media.
MAX_UPLOAD_BYTES=9000000000
SINGLE_PUT_MAX_BYTES=4900000000
MULTIPART_PART_SIZE_BYTES=67108864
MULTIPART_PRESIGN_BATCH_SIZE=12

# Explicit models are required so a release never silently changes model behavior.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol

# Upload the private .skill bundle to the private R2 bucket. Pin its checksum.
TIANCLIP_CORE_S3_KEY=private-core/tianzong-video-clipping-1.2.0-private.1.skill
TIANCLIP_CORE_SHA256=f8f132d70ceec1258f889e4342ff633b79966586e5793a9b67d8ae619b10a5ad
TIANCLIP_CORE_VERSION=1.2.0-private.1
TIANCLIP_PROMPT_VERSION=1.2.0
TIANCLIP_SCHEMA_VERSION=1.1.0
TIANCLIP_FACT_SCHEMA_VERSION=1.0.0
TIANCLIP_LEDGER_SCHEMA_VERSION=1.0.0

JOB_POLL_INTERVAL_MS=1500
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
# Worker independently reports liveness every 30 seconds. The API readiness
# gate and new-job admission fail closed after 120 seconds without a heartbeat.
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
TRANSCRIPTION_SEGMENT_SECONDS=600
VISION_SAMPLE_SECONDS=12
VISION_BATCH_SIZE=8
CANDIDATE_FRAME_SECONDS=2
ANALYSIS_WINDOW_SECONDS=600
# Render mounts the worker-only 30 GB scratch disk here. Local development can
# override this with /tmp/tianclip. This directory is disposable; private R2 is
# the durable source of truth.
WORK_DIRECTORY=/var/data/tianclip
