{$API_DOMAIN} {
  encode zstd gzip

  @progress path /progress/* /progress-data/*
  handle @progress {
    basic_auth {
      tianzong {$PROGRESS_PASSWORD_HASH}
    }
    reverse_proxy api:10000
  }

  @health path /healthz /readyz
  @api path /v1/*

  handle @health {
    reverse_proxy api:10000
  }

  handle @api {
    reverse_proxy api:10000
  }

  handle {
    respond "Not Found" 404
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
}
