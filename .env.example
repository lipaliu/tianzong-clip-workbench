# Runtime values are configured in Sites for production. Keep real credentials
# in ignored local env files and never commit them.
INTERNAL_AUTH_CREDENTIALS={"example-user":"replace-with-a-strong-password"}
INTERNAL_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-side HMAC bridge to the private Render processor. The key ID must
# exist in the processor's INTERNAL_API_KEYS JSON. Never expose the secret in
# NEXT_PUBLIC_* variables or browser code.
PROCESSOR_API_URL=https://replace-with-your-render-service.onrender.com
PROCESSOR_KEY_ID=sites-proxy
PROCESSOR_API_SECRET=replace-with-at-least-32-random-characters

# Server-only key used by the allowlisted OpenAI relay route. The browser never
# receives this value.
OPENAI_API_KEY=replace-with-openai-service-account-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: required when OPENAI_BASE_URL points to an authenticated Cloudflare AI Gateway.
OPENAI_GATEWAY_TOKEN=
OPENAI_SITES_BYPASS_TOKEN=replace-with-sites-server-to-server-bypass-token
DOUBAO_EDITOR_MODEL=doubao-seed-2-0-pro-260215
