{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tianzong-clip-workbench",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "PROCESSOR_API_URL": "https://price-goals-recorders-howard.trycloudflare.com",
    "PROCESSOR_KEY_ID": "sites-proxy"
  }
}
